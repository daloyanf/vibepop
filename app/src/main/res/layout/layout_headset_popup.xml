<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/popupRootContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- 充满整个卡片的全景动效弹窗 (支持视频/动图/Lottie，高度约 240dp) -->
    <FrameLayout
        android:id="@+id/cardPopup"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:background="@drawable/bg_popup_card"
        android:clipToOutline="true">

        <!-- 第 1 层：满铺多媒体展示区 (视频 MP4 / 动图 GIF / 图片 / Lottie) -->
        <FrameLayout
            android:id="@+id/mediaContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- 视频播放 (MP4 / WebM，FillVideoView 测量期 Center Crop 满铺无黑边) -->
            <com.vibepop.overlay.FillVideoView
                android:id="@+id/videoView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:visibility="gone" />

            <!-- 图片 / 动图 (PNG / JPG / WebP / GIF) -->
            <ImageView
                android:id="@+id/ivCustomImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:contentDescription="Custom Background Image" />

            <!-- Lottie 矢量动画 (.json) -->
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottieAnimationView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="visible"
                app:lottie_autoPlay="true"
                app:lottie_loop="true" />
        </FrameLayout>

        <!-- 第 2 层：柔和半透明景深渐变滤镜 (可按需控制) -->
        <View
            android:id="@+id/viewGradientOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_gradient_overlay" />

        <!-- 第 3 层：极简原生悬浮内容层 (无任何臃肿胶囊，纯粹轻盈) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="14dp">

            <!-- 顶部极简指示条 -->
            <ImageView
                android:id="@+id/ivDragHandle"
                android:layout_width="32dp"
                android:layout_height="3.5dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="2dp"
                android:src="@drawable/ic_pill_bar"
                android:contentDescription="Drag to dismiss" />

            <!-- 顶部信息栏：左侧设备信息与连接状态，右上角真实电量胶囊徽标 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- 左侧设备名与状态 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDeviceName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:shadowColor="#CC000000"
                        android:shadowDx="0"
                        android:shadowDy="2"
                        android:shadowRadius="6"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        tools:text="AirPods Pro 2" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@drawable/bg_button_rounded"
                            android:backgroundTint="#30D158" />

                        <TextView
                            android:id="@+id/tvConnectionStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:shadowColor="#CC000000"
                            android:shadowDx="0"
                            android:shadowDy="1"
                            android:shadowRadius="4"
                            android:text="@string/status_connected_text"
                            android:textColor="#E0E0E0"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 右上角单一真实电量徽标 -->
                <LinearLayout
                    android:id="@+id/layoutBatteryBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_battery_badge"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp">

                    <ImageView
                        android:id="@+id/ivBatteryIcon"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_battery"
                        app:tint="#34C759"
                        android:contentDescription="Battery Level" />

                    <TextView
                        android:id="@+id/tvBatteryLevel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:shadowColor="#99000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="3"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="85%" />

                    <ImageView
                        android:id="@+id/ivBatteryCharging"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginStart="2dp"
                        android:src="@drawable/ic_lightning"
                        android:visibility="gone"
                        android:contentDescription="Charging" />
                </LinearLayout>
            </LinearLayout>

            <!-- 留白让动画居中完美展现 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

        </LinearLayout>
    </FrameLayout>
</FrameLayout>
